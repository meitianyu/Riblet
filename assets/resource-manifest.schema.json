{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Riblet content-versioned resource catalogue",
  "type": "object",
  "required": ["schema", "resources"],
  "properties": {
    "schema": {"const": "riblet-resources-v1"},
    "resources": {"type": "array", "items": {
      "type": "object",
      "required": ["resource_id", "version", "bytes", "sha256", "roles", "routes", "models", "dependencies", "urls"],
      "properties": {
        "resource_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "roles": {"type": "array", "minItems": 1, "items": {"enum": ["model", "data"]}},
        "routes": {"type": "array", "minItems": 1, "items": {"enum": ["frozen", "construct"]}},
        "models": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}}
      }
    }}
  }
}
